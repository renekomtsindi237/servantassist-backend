# ==============================================================================
# ServantAssist Backend - Environment Configuration TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
#
# Generate strong keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME=ServantAssist
APP_ENV=development          # development | staging | production
APP_DEBUG=true               # Set to false in production
APP_URL=http://localhost:8000

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE — development uniquement (PostgreSQL local Docker)
# En staging/production, utiliser les variables SUPABASE_* ci-dessous.
# ──────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=servantassist
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=servantassist_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Auto-constructed from the above — override only if needed
DATABASE_URL=postgresql+asyncpg://servantassist:change-me-in-production@localhost:5432/servantassist_db

# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE — staging + production uniquement
# Laisser vide en développement (APP_ENV=development).
# ──────────────────────────────────────────────────────────────────────────────

# Dashboard Supabase → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Connexion DIRECTE — pour Alembic/migrations uniquement (pas de pgbouncer)
# Dashboard → Settings → Database → Connection string → URI
SUPABASE_DB_DIRECT_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Connection POOLER — pour le runtime FastAPI (pgbouncer mode Transaction, port 6543)
# Dashboard → Settings → Database → Connection pooling → Transaction
SUPABASE_DB_POOLER_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# ──────────────────────────────────────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ──────────────────────────────────────────────────────────────────────────────

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Connexion OAuth (Google) — connexion uniquement (voir POST /auth/oauth/google).
# Google Cloud Console → API et services → Identifiants → ID client OAuth 2.0
# (type Application Web). Laisser vide pour désactiver le bouton "Se connecter
# avec Google" côté frontend.
GOOGLE_OAUTH_CLIENT_ID=

# ──────────────────────────────────────────────────────────────────────────────
# SECURITY
# ──────────────────────────────────────────────────────────────────────────────

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret

ALLOWED_HOSTS=["localhost","127.0.0.1","localhost:8000"]

# ──────────────────────────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────────────────────────

CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ──────────────────────────────────────────────────────────────────────────────
# BRUTE-FORCE & RATE LIMITING
# ──────────────────────────────────────────────────────────────────────────────

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_GLOBAL=60
TRUST_PROXY_HEADERS=false

# ──────────────────────────────────────────────────────────────────────────────
# FILE UPLOAD
# ──────────────────────────────────────────────────────────────────────────────

MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_EXTENSIONS=["jpg","jpeg","png","webp"]
ALLOWED_DOCUMENT_EXTENSIONS=["pdf","doc","docx"]

# ──────────────────────────────────────────────────────────────────────────────
# EMAIL (SMTP)
# ──────────────────────────────────────────────────────────────────────────────

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Brevo SMTP relay — Dashboard Brevo → SMTP & API → SMTP
# Login : votre identifiant SMTP Brevo (ex. xxxxxxxx@smtp-brevo.com)
# Password : votre clé SMTP Brevo
# Leave empty in development to log emails instead of sending them
SMTP_USER=
SMTP_PASSWORD=

SMTP_FROM=noreply@servantassist.com
SMTP_FROM_NAME=ServantAssist

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND
# ──────────────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE R2 (Object Storage)
# ──────────────────────────────────────────────────────────────────────────────

# Format: https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key

# Bucket par défaut (obligatoire). Si les buckets spécialisés ci-dessous sont vides,
# tout est stocké ici ; les clés d’objets restent préfixées (profiles/, materials/, …).
CLOUDFLARE_R2_BUCKET=servantassist

# Buckets dédiés Cloudflare R2 (noms exacts du dashboard). Laisser vide = utiliser CLOUDFLARE_R2_BUCKET.
# materials/ et tasks/ retombent d’abord sur BUCKET_MATERIALS / BUCKET_TASKS, sinon sur BUCKET_IMAGES.
CLOUDFLARE_R2_BUCKET_IMAGES=
CLOUDFLARE_R2_BUCKET_PROFILES=
CLOUDFLARE_R2_BUCKET_MATERIALS=
CLOUDFLARE_R2_BUCKET_TASKS=
CLOUDFLARE_R2_BUCKET_REPORTS=
CLOUDFLARE_R2_BUCKET_TRAINING=
CLOUDFLARE_R2_BUCKET_DOCUMENTS=
CLOUDFLARE_R2_BUCKET_COMMUNICATION=
CLOUDFLARE_R2_BUCKET_EXPORTS=
CLOUDFLARE_R2_BUCKET_BACKUPS=

# URL publique par défaut (sans slash final) — ex. https://pub-XXXX.r2.dev ou votre CDN
CLOUDFLARE_R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev

# URL publique par usage (vide = réutiliser CLOUDFLARE_R2_PUBLIC_URL). À utiliser si chaque bucket
# a son propre domaine / binding public R2.
CLOUDFLARE_R2_PUBLIC_URL_IMAGES=
CLOUDFLARE_R2_PUBLIC_URL_PROFILES=
CLOUDFLARE_R2_PUBLIC_URL_MATERIALS=
CLOUDFLARE_R2_PUBLIC_URL_TASKS=
CLOUDFLARE_R2_PUBLIC_URL_REPORTS=
CLOUDFLARE_R2_PUBLIC_URL_TRAINING=
CLOUDFLARE_R2_PUBLIC_URL_DOCUMENTS=
CLOUDFLARE_R2_PUBLIC_URL_COMMUNICATION=
CLOUDFLARE_R2_PUBLIC_URL_EXPORTS=
CLOUDFLARE_R2_PUBLIC_URL_BACKUPS=

# ──────────────────────────────────────────────────────────────────────────────
# WHATSAPP (Meta Cloud API)
# ──────────────────────────────────────────────────────────────────────────────

WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# TWILIO (SMS/WhatsApp fallback)
# ──────────────────────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=

# ──────────────────────────────────────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO       # CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_FORMAT=json      # json | text

# ──────────────────────────────────────────────────────────────────────────────
# SENTRY (optionnel — laisser vide pour désactiver)
# ──────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ──────────────────────────────────────────────────────────────────────────────
# ADMIN INITIAL (utilisé par scripts/init_db.py)
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@servantassist.com
ADMIN_PASSWORD=ChangeMe_StrongPass1!
