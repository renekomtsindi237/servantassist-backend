{
  "info": {
    "name": "ServantAssist API",
    "description": "Collection complète des endpoints ServantAssist — backend FastAPI.\n\n**Configuration :**\n- Variable `base_url` → `http://localhost:8000/api/v1`\n- Variable `token` → renseignée automatiquement après le login\n\n**Ordre d'exécution recommandé :**\n1. Auth → Login\n2. Admin → créer servants / parents\n3. Tester les modules métier",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "servant_id", "value": "", "type": "string" },
    { "key": "event_id", "value": "", "type": "string" },
    { "key": "session_id", "value": "", "type": "string" },
    { "key": "invitation_code", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Authentification",
      "item": [
        {
          "name": "Login Admin (email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "  pm.test('Token reçu', () => pm.expect(json.access_token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "renekomtsindi7@gmail.com" },
                { "key": "password", "value": "Mbetoumou olive77" }
              ]
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Login Téléphone (servant/parent)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+237600000001\",\n  \"password\": \"ServTest2026!\"\n}"
            },
            "url": "{{base_url}}/auth/login/phone"
          }
        },
        {
          "name": "Inscription Servant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
