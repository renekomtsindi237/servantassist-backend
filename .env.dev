# ServantAssist — Environnement DEV local (Docker Compose)
# Ce fichier est lu par docker-compose.dev.yml

APP_NAME=ServantAssist
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# DB — ces valeurs sont surchargées par docker-compose.dev.yml
