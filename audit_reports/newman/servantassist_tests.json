{
  "info": {
    "_postman_id": "sa-audit-2026",
    "name": "ServantAssist API Tests",
    "description": "Comprehensive API test suite for ServantAssist backend. Covers auth, users, events, assignments, attendance, dashboard, cotisations, and security checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00_Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.test('Has status field', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01_Auth",
      "item": [
        {
          "name": "POST /auth/login — Admin",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "username", "value": "{{admin_email}}"},
                {"key": "password", "value": "{{admin_password}}"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has access_token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('access_token');",
                  "  pm.expect(json).to.have.property('refresh_token');",
                  "  pm.environment.set('admin_token', json.access_token);",
                  "  pm.environment.set('refresh_token', json.refresh_token);",
                  "});",
                  "pm.test('Response time < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login — Wrong Password → 401",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "username", "value": "{{admin_email}}"},
                {"key": "password", "value": "wrongpassword"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 on wrong password', () => pm.response.to.have.status(401));",
                  "pm.test('No token in error response', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.not.have.property('access_token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login — Missing Fields → 422",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "username", "value": "notanemail"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422 (validation) or 429 (rate limit)', () => {",
                  "  pm.expect([422, 429]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\": \"{{refresh_token}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('New access_token returned', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('access_token');",
                  "  pm.environment.set('admin_token', json.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/forgot-password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/v1/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"nonexistent@example.com\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Non-divulgation: 200 even if email not found', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "pm.test('No user info leaked in response', () => {",
                  "  const body = pm.response.text();",
                  "  pm.expect(body).to.not.include('password');",
                  "  pm.expect(body).to.not.include('hash');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02_Security",
      "item": [
        {
          "name": "GET /users — No Auth → 401",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 without auth', () => pm.response.to.have.status(401));",
                  "pm.test('Error message present', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('detail');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users — Invalid JWT → 401",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer invalidtoken.abc.xyz"}],
            "url": "{{base_url}}/api/v1/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 on invalid JWT', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Security Headers Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response time < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.test('Content-Type header present', () => {",
                  "  pm.expect(pm.response.headers.get('content-type')).to.include('application/json');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03_Users",
      "item": [
        {
          "name": "GET /users/me",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
            "url": "{{base_url}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('User data returned', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('email');",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.not.have.property('hashed_password');",
                  "  pm.environment.set('user_id', json.id);",
                  "});",
                  "pm.test('No password hash in response', () => {",
                  "  const body = pm.response.text();",
                  "  pm.expect(body).to.not.include('hashed_password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users — Admin list",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
            "url": "{{base_url}}/api/v1/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array or paginated result', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.satisfy(r => Array.isArray(r) || r.items || r.data);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04_Events",
      "item": [
        {
          "name": "POST /events — Create",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": "{{base_url}}/api/v1/events/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Event Newman\",\n  \"description\": \"Created by Newman audit test\",\n  \"event_type\": \"MESSE_DOMINICALE\",\n  \"start_time\": \"2026-04-01T09:00:00\",\n  \"end_time\": \"2026-04-01T11:00:00\",\n  \"location\": \"Eglise Test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 201', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Event ID returned', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.environment.set('event_id', json.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /events — List",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
            "url": "{{base_url}}/api/v1/events/?page=1&page_size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /events/{event_id}",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
            "url": "{{base_url}}/api/v1/events/{{event_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Event data complete', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('title');",
                  "  pm.expect(json).to.have.property('event_type');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /events/nonexistent → 404",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
            "url": "{{base_url}}/api/v1/events/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /events/{event_id}",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
            "url": "{{base_url}}/api/v1/events/{{event_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 204', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
